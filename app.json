{
  "expo": {
    "name": "QuéHay",
    "slug": "quehay-agenda-local",
    "version": "1.0.0",
    "scheme": "quehay",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C0392B"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "QuéHay usa tu ubicación para mostrarte eventos cercanos.",
        "NSPhotoLibraryUsageDescription": "QuéHay necesita acceso a tus fotos para subir pósteres de eventos.",
        "NSCameraUsageDescription": "QuéHay necesita la cámara para fotografiar pósteres de eventos."
      }
    },
    "android": {
      "package": "com.quehay.agendalocal",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C0392B"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "QuéHay necesita acceso a tus fotos para subir pósteres de eventos.",
          "cameraPermission": "QuéHay necesita la cámara para fotografiar pósteres de eventos."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9c68b543-93e9-4641-b47c-409a1a5c46f3"
      }
    },
    "owner": "marsu123"
  }
}
